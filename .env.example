# Porta do frontend (Next)
PORT=3000

# URL pública da API (backend)
# Usado em src/lib/api.ts → process.env.NEXT_PUBLIC_API_URL
#
# Local:
# NEXT_PUBLIC_API_URL=http://localhost:8787
#
# Produção (obrigatório HTTPS se o site for HTTPS):
# NEXT_PUBLIC_API_URL=https://api.cacurso.com.br

NEXT_PUBLIC_API_URL=http://localhost:8787
